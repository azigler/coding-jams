# Genuary Curator Agent Timer (Year-Agnostic)
#
# Triggers the curator agent every 4 hours for continuous museum building.
# Runs at :45 past the hour (0:45, 4:45, 8:45, 12:45, 16:45, 20:45 UTC).
#
# The timer pattern *-01-* works for any year - just update the
# SERVICE file paths each January.
#

[Unit]
Description=Run Genuary Curator Agent every 4 hours (January only)
Documentation=https://github.com/azigler/coding-jams

[Timer]
# Every 4 hours at :45 past the hour, January only
OnCalendar=*-01-* 00/4:45:00
AccuracySec=1min
Persistent=false

[Install]
WantedBy=timers.target
