# Genuary Curator Agent Timer (Year-Agnostic)
#
# Triggers the curator agent every hour for continuous museum building.
# Runs at :50 past every hour during January.
#
# If a session is still running, the new prompt just gets sent to the
# active window - slightly interruptive but not disruptive.
#

[Unit]
Description=Run Genuary Curator Agent hourly (January only)
Documentation=https://github.com/azigler/coding-jams

[Timer]
# Every hour at :50, January only
OnCalendar=*-01-* *:50:00
AccuracySec=1min
Persistent=false

[Install]
WantedBy=timers.target
