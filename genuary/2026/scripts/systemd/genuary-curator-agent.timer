# Genuary Curator Agent Timer (Year-Agnostic)
#
# Nudges the curator agent every 30 minutes to keep it going.
# Simple "keep going" message if already running.
#

[Unit]
Description=Nudge Genuary Curator Agent every 30 min (January only)
Documentation=https://github.com/azigler/coding-jams

[Timer]
# Every 30 minutes, January only
OnCalendar=*-01-* *:20,50:00
AccuracySec=1min
Persistent=false

[Install]
WantedBy=timers.target
