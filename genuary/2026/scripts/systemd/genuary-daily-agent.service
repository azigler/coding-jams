# Genuary Daily Agent Service (Multi-Year Support)
#
# This is a oneshot service that runs the daily agent script.
# It's triggered by the accompanying timer unit.
#
# Installation:
#   1. Copy this file: cp genuary-daily-agent.service ~/.config/systemd/user/
#   2. Copy timer: cp genuary-daily-agent.timer ~/.config/systemd/user/
#   3. Edit the paths below to match your installation and current year
#   4. Reload: systemctl --user daemon-reload
#   5. Enable: systemctl --user enable genuary-daily-agent.timer
#   6. Start: systemctl --user start genuary-daily-agent.timer
#
# Multi-Year Notes:
#   - Update GENUARY_YEAR and paths each January
#   - The script auto-detects year from directory, but explicit is safer
#   - Timer uses *-01-* which works for any year
#
# Check status:
#   systemctl --user status genuary-daily-agent.timer
#   systemctl --user list-timers
#
# View logs:
#   journalctl --user -u genuary-daily-agent.service -f
#

[Unit]
Description=Genuary Daily Agent (runs during January)
Documentation=https://github.com/azigler/coding-jams
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=7200

# ============================================================================
# CONFIGURE THESE PATHS FOR YOUR INSTALLATION
# Update the year (2026, 2027, etc.) as needed each January
# ============================================================================

# IMPORTANT: Systemd doesn't inherit user PATH - must set explicitly
# Include paths for: claude CLI, bun, cargo (for br), standard bins
Environment="PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/home/ubuntu"
Environment="GENUARY_REPO_PATH=/home/ubuntu/coding-jams/genuary/2026"
# Environment="GENUARY_YEAR=2026"

# Optional: Load API keys from a separate file
# EnvironmentFile=/home/ubuntu/.config/genuary/env

ExecStart=/home/ubuntu/coding-jams/genuary/2026/scripts/daily-agent-tmux.sh
WorkingDirectory=/home/ubuntu/coding-jams/genuary/2026

# Resource limits
MemoryMax=4G
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=genuary-agent

[Install]
WantedBy=default.target
