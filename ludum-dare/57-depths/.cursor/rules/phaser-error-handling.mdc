## Examples

✅ Correct:

```typescript
export class GameScene extends ErrorBoundaryScene {
  protected setupScene(): void {
    try {
      this.load.image('player', 'assets/player.png');
    } catch (error) {
      throw new AssetError('Failed to load player sprite');
    }

    GameLogger.log('info', 'Game scene initialized', {
      assets: this.cache.getKeys()
    });
  }

  update(): void {
    try {
      this.updateGameState();
    } catch (error) {
      GameLogger.error(error, { 
        scene: this.scene.key,
        gameTime: this.time.now 
      });
    }
  }
}
```

❌ Incorrect:

```typescript
export class GameScene extends Phaser.Scene {
  create() {
    // Don't use try-catch without proper error handling
    try {
      this.setupGame();
    } catch (e) {
      console.error(e);  // Don't just log errors
    }
    
    // Don't use console.log for debugging
    console.log('Game started');
    
    // Don't ignore errors
    this.load.image('player', 'missing.png');
  }
}
```
