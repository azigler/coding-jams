## Examples

✅ Correct:

```typescript
export class ClickingGame extends Phaser.Scene {
  create(): void {
    // Show click locations in debug
    if (process.env.DEBUG) {
      InputDebug.showClicks(this);
    }

    // Create clickable target
    const target = ShapeDrawer.clickableCircle(
      this,
      400,
      300,
      50,
      () => {
        const score = InputState.increment('score');
        this.events.emit('score-changed', score);
      },
      0x00ff00
    );

    // Track clicks in specific area
    const clickArea = ClickHandler.onClickArea(
      this,
      100,
      100,
      200,
      200,
      () => console.log('Area clicked!')
    );
  }

  destroy(): void {
    InputState.set('score', 0);
  }
}
```

❌ Incorrect:

```typescript
export class ClickingGame extends Phaser.Scene {
  score = 0;  // Don't use instance variables for game state

  create() {
    const circle = this.add.circle(400, 300, 50, 0x00ff00);
    
    // Don't use raw DOM events
    document.addEventListener('click', () => {
      this.score++;
    });
    
    // Don't use direct mouse coordinates
    this.input.on('pointerdown', (pointer) => {
      if (pointer.x > 100 && pointer.y > 100) {
        // Handle click
      }
    });
  }
}
```
