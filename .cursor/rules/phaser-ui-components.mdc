## Examples

✅ Correct:

```typescript
export class GameHUD extends UIComponent {
  private scoreText: Phaser.GameObjects.Text;
  private healthBar: ProgressBar;

  protected init(): void {
    // Create score display
    this.scoreText = new Text(this.scene, 0, 0, '0', {
      color: UITheme.colors.primary.toString(16),
      fontSize: UITheme.sizes.medium
    });

    // Create health bar
    this.healthBar = ProgressBar.create(this.scene, 0, 30, 100);
    
    // Add to container
    this.add([this.scoreText, this.healthBar]);
    
    // Apply layout
    UILayout.stack([this.scoreText, this.healthBar], 10);
  }

  public update(): void {
    this.scoreText.setText(GameState.get('score', 0).toString());
    this.healthBar.setValue(GameState.get('health', 100));
  }

  public destroy(): void {
    this.scoreText.destroy();
    this.healthBar.destroy();
    super.destroy();
  }
}
```

❌ Incorrect:

```typescript
class GameHUD {
  constructor(scene) {
    // Direct text creation without theme
    this.score = scene.add.text(10, 10, '0', { color: '#fff' });
    
    // Manual positioning without layout
    this.health = scene.add.rectangle(10, 30, 100, 10, 0xff0000);
  }
  
  // Missing proper cleanup
  destroy() {
    this.score.destroy();
  }
}
```
