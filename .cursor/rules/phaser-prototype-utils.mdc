- Rapid game prototyping
- Quick placeholder creation
- Easy debug visualization
- Simple state management
- Fast input setup
- Reusable physics presets
- Accelerated development

## Examples

✅ Correct:

```typescript
// Debug overlay usage
export class GameScene extends Phaser.Scene {
  create(): void {
    const player = this.add.sprite(400, 300, 'player');
    
    // Setup debug overlay
    DebugOverlay.create(this);
    DebugOverlay.watch('Player X', () => player.x);
    DebugOverlay.watch('Player Y', () => player.y);
    
    // Quick input setup
    const controls = InputHelper.setupWASD(this);
    InputHelper.setupDragAndDrop(player);
    
    // Physics preset
    PhysicsPresets.setupPlatformer(player);
    
    // Placeholder for missing asset
    const tempPlatform = PlaceholderAssets.createColoredBox(this, 200, 20, 0x00ff00);
    
    // State management
    GameState.set('score', 0);
    GameState.watch('score', (value) => {
      DebugOverlay.log(`Score: ${value}`);
    });
  }
}
```

❌ Incorrect:

```typescript
export class GameScene extends Phaser.Scene {
  create() {
    const player = this.add.sprite(400, 300, 'player');
    console.log('Player created');  // Using console.log instead of debug overlay
    
    // Direct key creation instead of helper
    this.input.keyboard.createCursorKeys();
    
    // Manual physics setup without presets
    player.body.setVelocity(0, 0);
  }
}
```
