## Examples

✅ Correct:

```typescript
// Menu Scene
const MenuScene = BaseScene.create('menu');

MenuScene.prototype.create = function() {
  ShapeDrawer.clickableCircle(
    this,
    400,
    300,
    100,
    () => SceneManager.switchTo(this, 'game', { level: 1 }),
    0x00ff00
  );

  if (process.env.DEBUG) {
    SceneDebug.showInfo(this);
  }
};

// Game Scene
const GameScene = BaseScene.create('game');

GameScene.prototype.init = function(data) {
  this.level = data.level;
};

GameScene.prototype.create = function() {
  SceneEvents.emit(this, 'game-started', { level: this.level });
  
  // Back to menu on click
  this.input.on('pointerdown', () => {
    SceneManager.switchTo(this, 'menu');
  });
};

GameScene.prototype.destroy = function() {
  SceneEvents.cleanup(this, 'game-started');
};
```

❌ Incorrect:

```typescript
export class GameScene extends Phaser.Scene {
  constructor() {
    super();  // Missing scene key
  }

  create() {
    // Direct scene manipulation without manager
    this.scene.start('menu');
    
    // Global event listeners without cleanup
    this.game.events.on('game-over', () => {});
    
    // Manual scene tracking
    this.previousScene = 'menu';
  }
}
```
