# AdventJS Session Configuration
# Copy this file to .env and add your session token

# Session token from __Secure-next-auth.session-token cookie
# Get this from your browser when logged into adventjs.dev:
# 1. Open Developer Tools (F12)
# 2. Go to Application > Cookies > adventjs.dev
# 3. Find __Secure-next-auth.session-token
# 4. Copy the Value here
ADVENTJS_SESSION_TOKEN=your_session_token_here

# Rate limit in milliseconds (default: 60000 = 60 seconds)
RATE_LIMIT_MS=60000

# Year for challenges (default: 2025)
ADVENTJS_YEAR=2025
